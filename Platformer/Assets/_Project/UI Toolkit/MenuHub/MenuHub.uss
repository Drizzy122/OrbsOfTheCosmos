.menu-hub {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(5, 3, 15);
    flex-direction: column;
}

.info-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 90px;
    padding: 0 60px;
    background-color: rgba(8, 5, 22, 0.98);
    border-bottom-width: 2px;
    border-bottom-color: rgba(120, 200, 225, 0.5);
}

.player-info {
    flex-direction: column;
    justify-content: center;
}

.player-name {
    font-size: 28px;
    color: rgb(170, 230, 248);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.player-level {
    font-size: 13px;
    color: rgb(150, 162, 186);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 2px;
}





.main-tabs {
    flex-grow: 1;
}

.main-tabs > .unity-tab-view__header-container {
    background-color: rgba(8, 5, 22, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 200, 225, 0.4);
    justify-content: center;
    height: 56px;
    flex-shrink: 0;
}

.main-tabs .unity-tab__header,
.main-tabs .unity-tab__header:hover,
.main-tabs .unity-tab__header:checked,
.main-tabs .unity-tab__header:focus,
.main-tabs .unity-tab__header:active {
    background-color: rgba(0, 0, 0, 0);
    padding: 0 32px;
    margin: 0;
    border-width: 0;
}

.main-tabs .unity-tab__header-label {
    color: rgb(130, 142, 166);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.main-tabs .unity-tab__header:hover .unity-tab__header-label {
    color: rgb(205, 242, 255);
}

.main-tabs .unity-tab__header:checked .unity-tab__header-label {
    color: rgb(170, 230, 248);
}

.main-tabs .unity-tab__header-underline {
    background-color: rgba(0, 0, 0, 0);
}

.main-tabs .unity-tab__header:checked .unity-tab__header-underline {
    background-color: rgb(170, 230, 248);
    height: 3px;
}

.page {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.page-placeholder {
    color: rgb(110, 122, 146);
    font-size: 24px;
    -unity-font-style: italic;
    letter-spacing: 1px;
}

.hints-bar {
    height: 48px;
    padding: 0 60px;
    background-color: rgba(8, 5, 22, 0.98);
    border-top-width: 1px;
    border-top-color: rgba(120, 200, 225, 0.4);
    align-items: center;
    justify-content: flex-end;
    flex-direction: row;
}

.hint-label {
    color: rgb(150, 162, 186);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.menu-hub .inventory-header {
    display: none;
}

.menu-hub TemplateContainer {
    flex-grow: 1;
}

.menu-hub .back-btn {
    display: none;
}

.menu-hub .unity-tab-view__chevron-button,
.menu-hub .unity-tab-view__previous-button,
.menu-hub .unity-tab-view__next-button,
.menu-hub .unity-tab-view__scroller-prev,
.menu-hub .unity-tab-view__scroller-next,
.menu-hub .unity-scroller__low-button,
.menu-hub .unity-scroller__high-button {
    display: none;
}

.menu-hub .unity-tab {
    flex-grow: 1;
}

.menu-hub #SettingsContainer .unity-tab-view {
    min-height: 900px;
}

/* ---------- input prompts ----------
   Replaces the old plain-text hint, which also named the wrong buttons: it read
   "LB / RB … B" while this project binds L1/R1 and closes on the touchpad.
   Local classes rather than MainMenuStyle's, since this UXML only imports MenuHub.uss. */

.hub-prompt {
    flex-direction: row;
    align-items: center;
    margin-left: 26px;
}

.hub-prompt-glyph {
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
    flex-shrink: 0;
}

.hub-prompt-label {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    color: rgb(150, 162, 186);
    font-size: 13px;
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}
