.menu-hub {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(5, 3, 15);
    flex-direction: column;
}

.info-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 90px;
    padding: 0 60px;
    background-color: rgba(8, 5, 22, 0.98);
    border-bottom-width: 2px;
    border-bottom-color: rgba(120, 200, 225, 0.5);
}

.player-info {
    flex-direction: column;
    justify-content: center;
}

.player-name {
    font-size: 28px;
    color: rgb(170, 230, 248);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.player-level {
    font-size: 13px;
    color: rgb(150, 162, 186);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 2px;
}





.main-tabs {
    flex-grow: 1;
}

.main-tabs > .unity-tab-view__header-container {
    background-color: rgba(8, 5, 22, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 200, 225, 0.4);
    justify-content: center;
    height: 56px;
    flex-shrink: 0;
}

.main-tabs .unity-tab__header,
.main-tabs .unity-tab__header:hover,
.main-tabs .unity-tab__header:checked,
.main-tabs .unity-tab__header:focus,
.main-tabs .unity-tab__header:active {
    background-color: rgba(0, 0, 0, 0);
    padding: 0 32px;
    margin: 0;
    border-width: 0;
}

.main-tabs .unity-tab__header-label {
    color: rgb(130, 142, 166);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.main-tabs .unity-tab__header:hover .unity-tab__header-label {
    color: rgb(205, 242, 255);
}

.main-tabs .unity-tab__header:checked .unity-tab__header-label {
    color: rgb(170, 230, 248);
}

.main-tabs .unity-tab__header-underline {
    background-color: rgba(0, 0, 0, 0);
}

.main-tabs .unity-tab__header:checked .unity-tab__header-underline {
    background-color: rgb(170, 230, 248);
    height: 3px;
}

.page {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.page-placeholder {
    color: rgb(110, 122, 146);
    font-size: 24px;
    -unity-font-style: italic;
    letter-spacing: 1px;
}

.hints-bar {
    height: 48px;
    padding: 0 60px;
    background-color: rgba(8, 5, 22, 0.98);
    border-top-width: 1px;
    border-top-color: rgba(120, 200, 225, 0.4);
    align-items: center;
    justify-content: flex-end;
    flex-direction: row;
}

.hint-label {
    color: rgb(150, 162, 186);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.menu-hub .inventory-header {
    display: none;
}

.menu-hub TemplateContainer {
    flex-grow: 1;
}

.menu-hub .back-btn {
    display: none;
}

.menu-hub .unity-tab-view__chevron-button,
.menu-hub .unity-tab-view__previous-button,
.menu-hub .unity-tab-view__next-button,
.menu-hub .unity-tab-view__scroller-prev,
.menu-hub .unity-tab-view__scroller-next,
.menu-hub .unity-scroller__low-button,
.menu-hub .unity-scroller__high-button {
    display: none;
}

.menu-hub .unity-tab {
    flex-grow: 1;
}

.menu-hub #SettingsContainer .unity-tab-view {
    min-height: 900px;
}

/* ---------- input prompts ----------
   Replaces the old plain-text hint, which also named the wrong buttons: it read
   "LB / RB … B" while this project binds L1/R1 and closes on the touchpad.
   Local classes rather than MainMenuStyle's, since this UXML only imports MenuHub.uss. */

.hub-prompt {
    flex-direction: row;
    align-items: center;
    margin-left: 26px;
}

.hub-prompt-glyph {
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
    flex-shrink: 0;
}

.hub-prompt-label {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    color: rgb(150, 162, 186);
    font-size: 13px;
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

/* ---------- quest log page ----------
   Two columns in the hub's own palette: the quest list on the left, the
   selected quest's status, rewards and requirements on the right. Items are
   coloured by state (locked / available / active / done). */

.quest-page {
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    padding: 28px 60px 24px 60px;
}

.quest-list-column {
    width: 340px;
    flex-shrink: 0;
    flex-direction: column;
    border-right-width: 1px;
    border-right-color: rgba(120, 200, 225, 0.25);
    padding-right: 24px;
    margin-right: 36px;
}

.quest-column-title {
    color: rgb(130, 142, 166);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.quest-list {
    flex-grow: 1;
}

.quest-list > #unity-horizontal-scroller {
    display: none;
}

.quest-list > #unity-vertical-scroller {
    width: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.quest-list > #unity-vertical-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.quest-list > #unity-vertical-scroller .unity-base-slider__dragger {
    width: 4px;
    margin-left: 1px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(120, 200, 225, 0.45);
}

.quest-empty {
    color: rgb(110, 122, 146);
    font-size: 16px;
    -unity-font-style: italic;
    white-space: normal;
    margin-top: 8px;
}

.quest-item {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    font-size: 18px;
    color: rgb(170, 182, 206);
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 10px 14px 10px 18px;
    margin: 2px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition-property: background-color, border-left-color, color;
    transition-duration: 0.12s;
}

.quest-item:hover {
    background-color: rgba(120, 200, 225, 0.08);
    color: rgb(205, 242, 255);
}

.quest-item:focus,
.quest-item.quest-item--selected {
    background-color: rgba(120, 200, 225, 0.14);
    border-left-color: rgb(170, 230, 248);
    color: rgb(205, 242, 255);
}

.quest-item.quest-item--locked { color: rgb(120, 110, 130); }
.quest-item.quest-item--available { color: rgb(170, 230, 248); }
.quest-item.quest-item--active { color: rgb(235, 190, 75); }
.quest-item.quest-item--done { color: rgb(100, 195, 130); }

.quest-detail-column {
    flex-grow: 1;
    flex-direction: column;
}

.quest-detail-head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.quest-detail-name {
    font-size: 30px;
    color: rgb(205, 242, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    white-space: normal;
    flex-shrink: 1;
}

.quest-state-tag {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(150, 162, 186);
    padding: 4px 10px;
    border-width: 1px;
    border-color: rgba(150, 162, 186, 0.6);
    border-radius: 2px;
    margin-left: 16px;
    margin-bottom: 6px;
}

.quest-state-tag.quest-item--locked { color: rgb(120, 110, 130); border-color: rgba(120, 110, 130, 0.6); }
.quest-state-tag.quest-item--available { color: rgb(170, 230, 248); border-color: rgba(170, 230, 248, 0.6); }
.quest-state-tag.quest-item--active { color: rgb(235, 190, 75); border-color: rgba(235, 190, 75, 0.6); }
.quest-state-tag.quest-item--done { color: rgb(100, 195, 130); border-color: rgba(100, 195, 130, 0.6); }

.quest-rule {
    height: 1px;
    background-color: rgba(120, 200, 225, 0.35);
    margin-top: 10px;
    margin-bottom: 18px;
    flex-shrink: 0;
}

.quest-detail-scroll {
    flex-grow: 1;
}

.quest-detail-scroll > #unity-horizontal-scroller {
    display: none;
}

.quest-detail-status {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    font-size: 18px;
    color: rgb(190, 200, 220);
    white-space: normal;
    margin-bottom: 28px;
}

.quest-info-row {
    flex-direction: row;
}

.quest-info-block {
    width: 300px;
    margin-right: 40px;
}

.quest-info-header {
    color: rgb(130, 142, 166);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 200, 225, 0.25);
    padding-bottom: 6px;
    margin-bottom: 8px;
}

.quest-info-line {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    font-size: 17px;
    color: rgb(205, 212, 228);
    white-space: normal;
    margin-bottom: 4px;
}
