<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/QuestStyle.uss?fileID=7433441132597879392&amp;guid=262dfd09358cb4644a169f44e7cc8489&amp;type=3#QuestStyle"/>
    <Style src="project://database/Assets/_Project/UI%20Toolkit/USS/HUD.uss?fileID=7433441132597879392&amp;guid=69cd5960cab7e7e4aa81246bf28a81ce&amp;type=3#HUD"/>
    <ui:VisualElement name="HUD" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="LowHealthVignette" class="hud-vignette" picking-mode="Ignore"/>
        <ui:VisualElement name="PlayerPlate" class="hud-plate" picking-mode="Ignore">
            <ui:VisualElement name="HealthRow" class="hud-row" picking-mode="Ignore">
                <ui:VisualElement name="LevelBadge" class="hud-level-badge" picking-mode="Ignore">
                    <ui:Label name="LevelBadgeLabel" text="1" class="hud-text hud-level-badge-text" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:VisualElement name="HealthContainer" class="hud-bar hud-bar--health" picking-mode="Ignore">
                    <ui:VisualElement name="HealthBar" class="hud-bar-fill hud-bar-fill--health" picking-mode="Ignore"/>
                </ui:VisualElement>
                <ui:Label name="HealthLabel" text="100 / 100" class="hud-text hud-bar-value" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:VisualElement name="StaminaContainer" class="hud-bar hud-bar--stamina" picking-mode="Ignore">
                <ui:VisualElement name="StaminaBar" class="hud-bar-fill hud-bar-fill--stamina" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:VisualElement name="XPContainer" class="hud-bar hud-bar--xp" picking-mode="Ignore">
                <ui:VisualElement name="XPBar" class="hud-bar-fill hud-bar-fill--xp" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:VisualElement name="ChargesRow" class="hud-row hud-charges-row" picking-mode="Ignore">
                <ui:VisualElement name="ChargesContainer" class="hud-pips" picking-mode="Ignore"/>
                <ui:Label name="ChargesLabel" text="x0" class="hud-text hud-charges-count" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:Label name="LockHint" text="TAB / R3   LOCK ON" class="hud-text hud-lock-hint" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="ComboContainer" class="hud-combo hud-combo--hidden" picking-mode="Ignore">
            <ui:Label name="ComboCount" text="0" class="hud-text hud-combo-count" picking-mode="Ignore"/>
            <ui:Label name="ComboLabel" text="HITS" class="hud-text hud-combo-label" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:Image source="project://database/Assets/_Project/Art/MyArt/LevelUp.png?fileID=-494394913&amp;guid=ae2f024aecf2db845ad9fdd8b1b2ee31&amp;type=3#LevelUp_0" name="LevelUpNotification" class="hud-levelup" picking-mode="Ignore">
            <ui:Image source="project://database/Assets/_Project/Art/MyArt/LevelUp.png?fileID=1380469893&amp;guid=ae2f024aecf2db845ad9fdd8b1b2ee31&amp;type=3#LevelUp_1" name="Icon" class="hud-levelup-icon" picking-mode="Ignore"/>
            <ui:Label text="LEVEL UP!" name="LevelUp" class="hud-text hud-levelup-title" picking-mode="Ignore"/>
            <ui:Label name="XPLevelLabel" text="You are now level 1" class="hud-text hud-levelup-text" picking-mode="Ignore"/>
        </ui:Image>
        <ui:Image source="project://database/Assets/_Project/Art/MyArt/Quest.png?fileID=1674060515&amp;guid=aeb41a4175181984799ebadfb3511e56&amp;type=3#QuestStartedNotification" name="MissionBoxContainer" class="hud-quest-box" picking-mode="Ignore">
            <ui:Image source="project://database/Assets/_Project/Art/MyArt/Quest.png?fileID=317291835&amp;guid=aeb41a4175181984799ebadfb3511e56&amp;type=3#Icon" name="Icon" class="hud-quest-icon" picking-mode="Ignore"/>
            <ui:Label text="QUEST STARTED" name="QuestStarted" class="hud-text hud-quest-heading" picking-mode="Ignore"/>
            <ui:Label name="QuestTitle" text="The Shadow Lair" class="hud-text hud-quest-title" picking-mode="Ignore"/>
            <ui:Label name="QuestStatus" text="Journey into the Darkwood forest and confront the shadow lord" class="hud-text hud-quest-status" picking-mode="Ignore"/>
        </ui:Image>
        <ui:VisualElement name="TopCenter" class="hud-top-center" picking-mode="Ignore">
            <ui:VisualElement name="NotificationSlot" class="hud-notification-slot" picking-mode="Ignore">
                <ui:VisualElement name="NotificationContainer" class="hud-notification" picking-mode="Ignore">
                    <ui:Label name="NotificationText" text="Notification" class="hud-text hud-notification-text" picking-mode="Ignore"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TargetMarker" class="hud-lock" picking-mode="Ignore">
            <ui:VisualElement name="LockCornerTL" class="hud-lock-corner hud-lock-corner--tl" picking-mode="Ignore"/>
            <ui:VisualElement name="LockCornerTR" class="hud-lock-corner hud-lock-corner--tr" picking-mode="Ignore"/>
            <ui:VisualElement name="LockCornerBL" class="hud-lock-corner hud-lock-corner--bl" picking-mode="Ignore"/>
            <ui:VisualElement name="LockCornerBR" class="hud-lock-corner hud-lock-corner--br" picking-mode="Ignore"/>
            <ui:VisualElement name="LockCenter" class="hud-lock-center" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="TargetOffscreen" class="hud-lock-offscreen" picking-mode="Ignore">
            <ui:VisualElement name="TargetOffscreenArrow" class="hud-lock-arrow" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="WaypointContainer" class="hud-waypoint" picking-mode="Ignore">
            <ui:Label name="MeterLabel" text="100m" class="hud-text hud-waypoint-meter" picking-mode="Ignore"/>
        </ui:VisualElement>
        <ui:VisualElement name="BottomCenter" class="hud-bottom-center" picking-mode="Ignore">
            <ui:VisualElement name="DialogueContainer" class="hud-dialogue" picking-mode="Ignore">
                <ui:Label name="DialogueText" text="" class="hud-text hud-dialogue-text" picking-mode="Ignore"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ChoicesContainer" class="hud-choices"/>
    </ui:VisualElement>
</ui:UXML>
