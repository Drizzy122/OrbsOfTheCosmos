/* ── Toggle row ─────────────────────────────────── */
.unity-toggle {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.04);
    padding: 10px 20px;
    margin-bottom: 12px;
    border-radius: 8px;
    transition-duration: 0.15s;
}

.unity-toggle:hover {
    background-color: rgba(120, 200, 225, 0.06);
}

.unity-toggle:focus {
    background-color: rgba(120, 200, 225, 0.12);
    border-width: 1px;
    border-color: rgba(120, 200, 225, 0.5);
    border-radius: 8px;
}

/* ── Checkbox box ───────────────────────────────── */
.unity-toggle__checkmark {
    background-image: none;
    background-color: rgba(0, 0, 0, 0.6);
    border-color: rgba(120, 200, 225, 0.6);
    border-width: 2px;
    border-radius: 5px;
    width: 24px;
    height: 24px;
    transition-duration: 0.12s;
    margin-right: 0;
}

/* ── Checked state ──────────────────────────────── */
.unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: none;
    background-color: rgb(120, 200, 225);
    border-color: rgb(70, 125, 150);
    border-width: 3px;
}
