:root {
    --void: rgb(5, 3, 14);
    --violet: rgb(155, 109, 255);
    --cyan: rgb(95, 230, 255);
    --star: rgb(234, 230, 255);
    --dust: rgb(110, 101, 144);
    --dim: rgb(61, 54, 96);
}

/* ---------- screen scaffold ---------- */

.screen {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0);
}

/* USS has no linear-gradient, so the soft left edge is two stacked solids. */
.scrim {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 30%;
    background-color: rgba(5, 3, 14, 0.94);
}

.scrim-falloff {
    position: absolute;
    left: 30%;
    top: 0;
    bottom: 0;
    width: 14%;
    background-color: rgba(5, 3, 14, 0.45);
}

.menu-column {
    width: 34%;
    min-width: 320px;
    flex-direction: column;
    justify-content: space-between;
    padding-left: 7%;
    padding-top: 7%;
    padding-bottom: 5%;
}

/* ---------- title ---------- */

.title {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/Ottselesque-Regular.otf?fileID=12800000&guid=b00bfdbd79d843a46b8b3fb62f619d32&type=3#Ottselesque-Regular");
    color: var(--star);
    font-size: 62px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: upper-left;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.65);
    margin-bottom: 14px;
}

.title-rule {
    width: 170px;
    height: 2px;
    background-color: var(--violet);
}

/* ---------- menu items ---------- */

.menu-items {
    flex-direction: column;
}

.button {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    background-color: rgba(0, 0, 0, 0);
    color: var(--star);
    font-size: 30px;
    letter-spacing: 6px;
    -unity-text-align: middle-left;
    align-self: flex-start;
    height: auto;
    width: auto;
    margin: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-right: 26px;
    padding-left: 16px;
    /* The rail is always present and transparent, so hover causes no layout shift. */
    border-left-width: 3px;
    border-left-color: rgba(155, 109, 255, 0);
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
    transition-property: color, background-color, border-left-color, padding-left, letter-spacing;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.button:hover {
    color: var(--star);
    background-color: rgba(155, 109, 255, 0.09);
    border-left-color: var(--violet);
    padding-left: 26px;
    letter-spacing: 8px;
}

/* Focus is cyan so gamepad navigation never looks like a mouse hover. */
.button:focus {
    color: var(--cyan);
    background-color: rgba(95, 230, 255, 0.11);
    border-left-color: var(--cyan);
    padding-left: 26px;
    letter-spacing: 8px;
}

.button:active {
    color: var(--star);
    background-color: rgba(95, 230, 255, 0.2);
}

/* Explicit opacity so we control the look instead of UI Toolkit's default dimming. */
.button:disabled {
    opacity: 1;
    color: var(--dim);
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(155, 109, 255, 0);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* ---------- save context under Continue ---------- */

.meta {
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/MyFont.ttf?fileID=12800000&guid=6384753b77039dc43a7bf85678bfc68d&type=3#MyFont");
    color: var(--dust);
    font-size: 14px;
    letter-spacing: 2px;
    margin-left: 19px;
    margin-top: -4px;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- footer ---------- */

.menu-footer {
    flex-direction: column;
}

.button--quiet {
    font-size: 18px;
    color: var(--dust);
    letter-spacing: 5px;
}

.button--quiet:hover {
    color: rgb(201, 182, 255);
    background-color: rgba(155, 109, 255, 0.07);
}

.button--quiet:focus {
    color: var(--cyan);
}

.version {
    position: absolute;
    right: 24px;
    bottom: 18px;
    color: var(--dim);
    font-size: 13px;
    letter-spacing: 2px;
    background-color: rgba(0, 0, 0, 0);
}
